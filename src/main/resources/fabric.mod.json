{
	"schemaVersion": 1,
	"id": "milwer-macros",
	"version": "${version}",
	"name": "Milwer Macros",
	"description": "A minecraft mod with quality of life macros for Milwer",
	"authors": [
		"Appa"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": ""
	},
	"license": "MIT-License",
	"icon": "assets/milwer-macros/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.appayip.MilwerMacros"
		],
		"client": [
			"io.github.appayip.client.MilwerMacrosClient"
		],
		"fabric-datagen": [
			"io.github.appayip.client.MilwerMacrosDataGenerator"
		]
	},
	"mixins": [
